{
  "name": "open-financial-charts",
  "version": "0.1.0",
  "homepage": "https://gunnarpdx.github.io/OpenFinancialCharts/",
  "description": "Advanced financial chart React component with a pluggable data feed (candles, studies, drawings, scripting)",
  "license": "AGPL-3.0-only",
  "author": "Gunnar Rosenberg",
  "keywords": [
    "react",
    "charts",
    "financial-charts",
    "candlestick",
    "trading",
    "technical-analysis",
    "indicators",
    "ohlcv",
    "visx"
  ],
  "main": "dist/cjs/lib.js",
  "module": "dist/lib.js",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist"
  ],
  "dependencies": {
    "@use-gesture/react": "^10.2.27",
    "@visx/axis": "^3.1.0",
    "@visx/brush": "^3.0.1",
    "@visx/curve": "^3.0.0",
    "@visx/event": "^3.0.1",
    "@visx/gradient": "^3.0.0",
    "@visx/grid": "^3.0.1",
    "@visx/group": "^3.0.0",
    "@visx/pattern": "^3.3.0",
    "@visx/responsive": "^3.0.0",
    "@visx/scale": "^3.0.0",
    "@visx/shape": "^3.0.0",
    "@visx/tooltip": "^3.1.2",
    "d3-format": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-time-format": "^4.1.0",
    "theta-script": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "puppeteer-core": "^25.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "sass": "^1.62.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:lib": "rm -rf dist && babel src --out-dir dist --ignore 'src/index.js','src/setupTests.js','src/demo/**','src/styles/**','src/**/*.test.js' && BABEL_ENV=cjs babel src --out-dir dist/cjs --ignore 'src/index.js','src/setupTests.js','src/demo/**','src/styles/**','src/**/*.test.js' && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json && sass src/styles/package.scss dist/styles.css --no-source-map",
    "prepack": "npm run build:lib"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(theta-script|d3-scale|d3-array|d3-interpolate|d3-color|d3-format|d3-time|d3-time-format|d3-shape|d3-path|internmap)/)"
    ],
    "moduleNameMapper": {
      "^theta-script$": "<rootDir>/node_modules/theta-script/src/interpreter.js",
      "^theta-script/(docs|examples|math|rewriteStyle|builtins)$": "<rootDir>/node_modules/theta-script/src/$1.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "exports": {
    ".": {
      "import": "./dist/lib.js",
      "require": "./dist/cjs/lib.js"
    },
    "./styles.css": "./dist/styles.css",
    "./dist/styles.css": "./dist/styles.css"
  }
}
